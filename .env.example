# Default — MSW only (no Echo required)
VITE_API_MODE=mock
VITE_API_BASE_URL=/api

# ── Hybrid / live (P1-A) — copy to .env.local ─────────────────────────────
# VITE_API_MODE=hybrid
# VITE_API_BASE_URL=/api
# VITE_ECHO_BASE_URL=/api/echo
# VITE_ECHO_LOGIN_USER=alice
# VITE_STAGE_TENANT_ID=30897
# VITE_STAGE_USERNAME=you@company.com
# Never put a password in VITE_* — it is baked into the browser bundle.
