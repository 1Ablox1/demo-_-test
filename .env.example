# Default — MSW only (no Echo required)
VITE_API_MODE=mock
VITE_API_BASE_URL=/api

# ── Hybrid / live — copy to .env.local ─────────────────────────────────────
# VITE_API_MODE=hybrid
# VITE_API_BASE_URL=/api
# VITE_ECHO_BASE_URL=/api/echo
# VITE_ECHO_PROXY_TARGET=http://127.0.0.1:9100
#
# Auth modes:
#   password — OS login page → POST { username, password } (default)
#   stub     — username only (Echo stub-mode)
#   session  — paste / ?sessionId=
# VITE_ECHO_AUTH_MODE=password
# VITE_ECHO_LOGIN_USER=aLice@cargowareos.com
# VITE_ECHO_LOGIN_PASSWORD=   # optional prefill — never commit real secrets
#
# Open http://127.0.0.1:5173/login → Log in
